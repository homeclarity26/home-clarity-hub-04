name: Golden Path

# Three-tier strategy:
#   Tier 1 (always): build, typecheck, static-integrity. ~60-90s. Cheap.
#   Tier 2 (path-gated): DB/RLS scripts. Only when src/, supabase/, scripts/ change.
#   Tier 3 (path-gated): AI scripts. Only when supabase/functions/, golden-path*.ts,
#                        or workflows change. CI_USE_GEMINI routes Claude→Gemini Flash.
#
# Daily 12:00 UTC schedule and the workflow_dispatch "run_full_suite" toggle
# both bypass path filters and run every tier.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    - cron: '0 12 * * *'
  workflow_dispatch:
    inputs:
      run_full_suite:
        description: 'Run all tiers regardless of path changes'
        type: boolean
        default: true

concurrency:
  group: golden-path-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # --- Path-change detection. Outputs feed Tier 2/3 if: conditions. ---
  changes:
    name: Detect path changes
    runs-on: ubuntu-latest
    timeout-minutes: 2
    outputs:
      backend: ${{ steps.filter.outputs.backend }}
      ai: ${{ steps.filter.outputs.ai }}
    steps:
      - uses: actions/checkout@v4
      - uses: dorny/paths-filter@v3
        id: filter
        with:
          filters: |
            backend:
              - 'supabase/**'
              - 'src/**'
              - 'scripts/**'
            ai:
              - 'supabase/functions/**'
              - 'scripts/golden-path*.ts'
              - '.github/workflows/**'

  # =========================================================================
  # TIER 1 — Static checks. Always run. ~60-90s end-to-end.
  # =========================================================================

  tier1-build:
    name: Tier 1 — Build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - run: bun install --frozen-lockfile
      - run: bun run build

  tier1-typecheck:
    name: Tier 1 — Typecheck
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - run: bun install --frozen-lockfile
      - run: npx tsc --noEmit

  tier1-static-integrity:
    name: Tier 1 — Static integrity
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
      SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
      SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
      # Test 57 in static-integrity invokes hbc-agent (Gemini-native). The
      # CI_USE_GEMINI flag also routes any callClaude() through Gemini Flash
      # so this tier never burns Anthropic credit.
      CI_USE_GEMINI: "true"
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - run: bun install --frozen-lockfile
      - name: Run static-integrity (3 retries — test 57 hits hbc-agent)
        run: |
          for attempt in 1 2 3; do
            echo "::group::Attempt $attempt"
            if bun scripts/golden-path-static-integrity.ts; then
              echo "::endgroup::"
              exit 0
            fi
            echo "::endgroup::"
            echo "Attempt $attempt failed; sleeping 20s before retry…"
            sleep 20
          done
          echo "All 3 attempts failed — a real regression, not AI flake."
          exit 1

  # =========================================================================
  # TIER 2 — Deterministic Golden Paths (DB / RLS). Path-gated.
  # =========================================================================
  tier2-deterministic:
    name: Tier 2 — Deterministic Golden Paths
    runs-on: ubuntu-latest
    needs: [changes, tier1-build]
    if: |
      needs.changes.outputs.backend == 'true' ||
      github.event_name == 'schedule' ||
      (github.event_name == 'workflow_dispatch' && inputs.run_full_suite)
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        flow:
          - messaging
          - proposal
          - equipment-schedule
          - rls
          - mobile
    env:
      SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
      SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
      SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - run: bun install --frozen-lockfile
      - name: Run Golden Path (${{ matrix.flow }})
        run: bun scripts/golden-path-${{ matrix.flow }}.ts

  # =========================================================================
  # TIER 3 — AI-dependent Golden Paths. Path-gated. Up to 3 retries per flow
  # so transient Gemini/Claude 5xx don't red-bar the suite. CI_USE_GEMINI
  # keeps the spend in Gemini Flash territory.
  # =========================================================================
  tier3-ai:
    name: Tier 3 — AI-dependent Golden Paths
    runs-on: ubuntu-latest
    needs: [changes, tier1-build]
    if: |
      needs.changes.outputs.ai == 'true' ||
      github.event_name == 'schedule' ||
      (github.event_name == 'workflow_dispatch' && inputs.run_full_suite)
    timeout-minutes: 25
    strategy:
      fail-fast: false
      matrix:
        include:
          - flow: core
            script: scripts/golden-path.ts
          - flow: ai-writing
            script: scripts/golden-path-ai-writing.ts
          - flow: learning
            script: scripts/golden-path-learning.ts
          - flow: content-ops
            script: scripts/golden-path-content-ops.ts
          - flow: quality-controls
            script: scripts/golden-path-quality-controls.ts
          - flow: photos
            script: scripts/golden-path-photos.ts
          - flow: wizard
            script: scripts/golden-path-wizard.ts
    env:
      SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
      SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
      SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
      CI_USE_GEMINI: "true"
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest
      - run: bun install --frozen-lockfile
      - name: Run Golden Path (${{ matrix.flow }}) with retries
        run: |
          for attempt in 1 2 3; do
            echo "::group::Attempt $attempt"
            if bun ${{ matrix.script }}; then
              echo "::endgroup::"
              exit 0
            fi
            echo "::endgroup::"
            echo "Attempt $attempt failed; sleeping 20s before retry…"
            sleep 20
          done
          echo "All 3 attempts failed — a real regression, not AI flake."
          exit 1
